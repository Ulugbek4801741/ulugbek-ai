# Server environment variables. Never commit real values.
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://YOUR-SERVER-DOMAIN
# Exact public frontend origin, e.g. https://YOURNAME.github.io (no path)
FRONTEND_ORIGIN=https://ulugbek4801741.github.io
# Optional persistent path; use a durable mounted disk in production hosting
AGENT_MEMORY_PATH=./data/agent-memory.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAIL=your-authorized-google-account@gmail.com
ADMIN_SESSION_SECRET=

# Choose ONE AI setup:
# A) Hosted provider: set OPENAI_API_KEY and use its compatible base URL.
# B) Self-hosted OpenAI-compatible server (e.g. Ollama/vLLM): leave key empty,
#    set OPENAI_BASE_URL to that server's API base URL and OPENAI_MODEL to a model it serves.
# Example only; replace with your real private server address:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Future durable data services (schema and readiness plan added; not yet wired into routes)
DATABASE_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Required to read/write private research knowledge and agent memories via /api/lab.
# Generate a unique random secret with at least 32 characters. Never commit the real value.
LAB_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
