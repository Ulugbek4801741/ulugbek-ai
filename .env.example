# ULUGBEK AI server configuration template. Never commit real secrets.
PORT=3000
NODE_ENV=production

# Browser frontends. Capacitor Android uses https://localhost (already allowed).
FRONTEND_ORIGIN=https://ulugbek4801741.github.io

# Persistent storage paths. On Render, mount a persistent disk before relying on JSON memory.
ULUGBEK_DATA_DIR=./data
AGENT_MEMORY_PATH=./data/agent-memory.json
TASK_STORE_PATH=./data/tasks.json

# Admin and research access: replace each placeholder with a unique random secret.
ADMIN_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_ACCESS_CODE=replace-with-a-private-admin-code
LAB_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Optional self-hosted OpenAI-compatible language model.
# This project reads these ULUGBEK_LOCAL_MODEL_* names (not OPENAI_BASE_URL/OPENAI_MODEL).
# The model server must be reachable from this Render service over HTTPS or private networking.
ULUGBEK_LOCAL_MODEL_URL=
ULUGBEK_LOCAL_MODEL_NAME=
ULUGBEK_LOCAL_MODEL_TOKEN=

# Optional image generation: Stable Diffusion WebUI API base URL.
IMAGE_GENERATION_URL=
IMAGE_GENERATION_USERNAME=
IMAGE_GENERATION_PASSWORD=

# Optional video generation: ComfyUI base URL and an uploaded workflow JSON path.
VIDEO_COMFYUI_URL=
VIDEO_COMFYUI_USERNAME=
VIDEO_COMFYUI_PASSWORD=
VIDEO_COMFYUI_WORKFLOW=
VIDEO_PROMPT_NODE_ID=
VIDEO_PROMPT_INPUT=text

# Future integrations below are not wired to production routes yet.
DATABASE_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
